# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
APP_NAME="NursesCare Platform API"

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5000,https://nurse-app-be-chi.vercel.app

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=test
DB_USER=myuser
DB_PASSWORD=root
DB_SSL=false

# ── Encryption (pgcrypto symmetric key) ──────────────────────────────────────
DB_ENCRYPTION_KEY=change-me-to-a-32-byte-secret-key!!

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-very-long-random-secret
JWT_EXPIRES_IN=30m
REFRESH_TOKEN_SECRET=change-me-to-another-long-random-secret
REFRESH_TOKEN_EXPIRES_IN=7d

# ── MFA / TOTP ────────────────────────────────────────────────────────────────
MFA_ISSUER=NursesCare

# ── OAuth 2.0 – Google ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/google/callback

# ── OAuth 2.0 – Microsoft ─────────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/microsoft/callback

# ── File storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
